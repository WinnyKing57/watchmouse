#!/bin/sh
set -e

if [ -d /run/systemd/system ]; then
  systemctl daemon-reload >/dev/null 2>&1 || true
  systemctl enable watchmouse-host >/dev/null 2>&1 || true
  systemctl start watchmouse-host >/dev/null 2>&1 || true
fi

if [ "$1" = "configure" ]; then
  # Load the uinput module (nothing happens if already built-in).
  modprobe uinput 2>/dev/null || true
  gtk-update-icon-cache -f /usr/share/icons/hicolor 2>/dev/null || true
fi

exit 0
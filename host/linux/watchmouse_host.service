[Unit]
Description=WatchMouse Linux host (uinput)
After=multi-user.target

[Service]
Type=simple
EnvironmentFile=-/etc/watchmouse-host.env
ExecStart=/usr/bin/python3 /opt/watchmouse-host/watchmouse_host.py --port 8888 --pin '${WATCHMOUSE_PIN}'
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target